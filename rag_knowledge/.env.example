# ==============================================================================
# RAG Knowledge Subsystem - Environment Configuration Example
# ==============================================================================
# Copy this file to .env in your root directory or provide these in your environment.
# Note: If GEMINI_API_KEY is omitted, the system seamlessly falls back to 
# returning structured factual knowledge directly without failing.

# Google Gemini API Keys (Separate keys supported to prevent token & rate limits)
# Primary key for conversational answer synthesis
GEMINI_API_KEY=your_gemini_api_key_here
# Optional dedicated key for text synthesis (overrides GEMINI_API_KEY for queries)
# GEMINI_TEXT_API_KEY=your_gemini_text_api_key_here
# Optional dedicated key for Vision OCR and image ingestion (prevents query quota exhaustion)
# GEMINI_VISION_API_KEY=your_gemini_vision_api_key_here

# Qdrant Vector Database Connection (Required for vector retrieval)
# Obtain cluster endpoint & API key from Qdrant Cloud (https://cloud.qdrant.io/) or local container
QDRANT_URL=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_WRITE_API_KEY=your_qdrant_write_api_key_here
QDRANT_COLLECTION=riva_knowledge

# Embedding Model (Optional, defaults to BAAI/bge-small-en-v1.5 via FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Gemini Model Configuration (Driven by env, zero code hardcoding)
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
# Optional dedicated models for text synthesis vs. vision ingestion
# GEMINI_TEXT_MODEL=gemini-flash-lite-latest
# GEMINI_VISION_MODEL=gemini-flash-lite-latest
# GEMINI_VISION_FALLBACK_MODELS=gemini-1.5-flash,gemini-2.0-flash

# Ingestion & OCR Configuration
# Set ALLOW_CLOUD_VISION=1 or true to enable Gemini Vision OCR for images
# (Recommended when local Tesseract is not installed or for complex diagrams)
ALLOW_CLOUD_VISION=true
# Optional comma-separated filter for specific files/directories allowed to use Cloud Vision
# ALLOW_CLOUD_VISION_ALLOWLIST=raw/scans,diagrams

# Security & Data Protection
# Salt secret for anonymizing and hashing student IDs in tabular joins
RAG_ENTITY_SECRET=your_hmac_secret_salt_here
# Safeguard: prevents accidental --clear or deletion on production collection
LIVE_COLLECTION=riva_knowledge_prod

# Timeouts in seconds (Optional, defaults to 15.0 / 20.0 to prevent WAN ReadTimeout)
QDRANT_TIMEOUT=60.0
GEMINI_TIMEOUT=20.0

# Retrieval & Synthesis Tuning (Optional)
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.40
# RAG_CONTEXT_MIN_SCORE=50.0
# RAG_MAX_CONTEXT_CHARS=25000
# RAG_MAX_QUERY_CHARS=1000
# GEMINI_MAX_OUTPUT_TOKENS=1500
# GEMINI_TEMPERATURE=0.2

# Legacy lowercase variable names (also supported for backward compatibility):
# qdrant_cluster_endpoint=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
# qdrant_api=your_qdrant_api_key_here

# Allow loading .env from current working directory (Optional, defaults to false)
# RAG_LOAD_CWD_ENV=false
