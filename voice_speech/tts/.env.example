# ==============================================================================
# TTS Module — Environment Variables Configuration
# Copy this file to .env and fill in your actual API keys and preferences.
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ElevenLabs (Default API engine — Highest Voice Quality & Voice Cloning)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"  # George (default)

# ------------------------------------------------------------------------------
# 2. Cartesia Sonic (Latency-critical path — ~65ms TTFA)
# ------------------------------------------------------------------------------
CARTESIA_API_KEY=""
CARTESIA_MODEL_ID="sonic-2"
CARTESIA_VOICE_ID="a0e99841-438c-4a64-b679-ae501e7d6091"

# ------------------------------------------------------------------------------
# 3. OpenAI TTS (Secondary API engine — $15 / 1M chars)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_TTS_MODEL="tts-1"           # tts-1 or tts-1-hd
OPENAI_TTS_VOICE="alloy"           # alloy, echo, fable, onyx, nova, shimmer

# ------------------------------------------------------------------------------
# 4. Azure Neural TTS (Backup API path — ~$16 / 1M chars)
# ------------------------------------------------------------------------------
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"
AZURE_SPEECH_VOICE="en-US-AriaNeural"

# ------------------------------------------------------------------------------
# 5. Piper Local Backend (Offline fallback — $0 cost)
# ------------------------------------------------------------------------------
PIPER_BINARY="piper"
PIPER_MODEL="en_US-lessac-medium.onnx"
PIPER_MODEL_CONFIG="en_US-lessac-medium.onnx.json"

# ------------------------------------------------------------------------------
# 6. Router & System Options
# ------------------------------------------------------------------------------
TTS_COST_BUDGET_PER_REQUEST="0.005"   # USD budget limit per turn before warning
ENABLE_VOICE_CLONING="false"           # Set to "true" to allow cloning backends
TTS_LOG_FILE="tts_requests.jsonl"     # Structured JSONL log destination
